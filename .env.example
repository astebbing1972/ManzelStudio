# GA4 / Search Console / Ahrefs snippet setup
# See: webalive.atlassian.net/wiki/spaces/Effektiv/pages/2660892673
#
# Copy this file to .env.local for local testing, and set the same values
# as environment variables in Netlify (Site configuration > Environment
# variables) so they're baked in at build time on the live site. Each
# snippet below is a no-op until its variable is set - safe to leave unset.

# GA4 Measurement ID, from GA4 > Admin > Data Streams > (web stream).
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification code (the "content" value from
# the <meta name="google-site-verification"> tag GSC gives you). Not needed
# if verifying via the linked GA4 property instead.
NEXT_PUBLIC_GSC_VERIFICATION=

# Ahrefs Site Audit/Rank Tracker HTML-tag verification code (the "content"
# value from the <meta name="ahrefs-site-verification"> tag). Not needed if
# the Ahrefs project is verified via DNS TXT record instead.
NEXT_PUBLIC_AHREFS_VERIFICATION=

# Bing Webmaster Tools HTML-tag verification code (the "content" value from
# the <meta name="msvalidate.01"> tag Bing gives you). Not needed if
# verifying via the imported GSC property instead.
NEXT_PUBLIC_BING_VERIFICATION=

# Ahrefs Web Analytics key (only if Web Analytics is being used for this
# client, separate from Site Audit/Rank Tracker).
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=
